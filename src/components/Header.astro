---
import ThemeControl from "./ThemeControl.astro";
---

<header class="flex items-center justify-between gap-5">
  <a class="home-road" href="/" aria-label="Home" title="Home">
    <svg viewBox="0 0 36 40" width="31" height="35" aria-hidden="true">
      <path
        d="M22 3C7 10 33 13 22 21S6 29 12 37"
        fill="none"
        stroke="currentColor"
        stroke-width="10"
        stroke-linecap="round"
      />
      <path
        d="M22 3C7 10 33 13 22 21S6 29 12 37"
        fill="none"
        stroke="var(--road-dash,#ffe4a2)"
        stroke-width="1.4"
        stroke-dasharray="3 4"
      />
    </svg>
  </a>
  <nav aria-label="Main navigation">
    <a
      href="/about/"
      aria-current={
        Astro.url.pathname.startsWith("/about") ? "page" : undefined
      }
    >
      about
    </a>
    <a
      href="/work/"
      aria-current={Astro.url.pathname.startsWith("/work") ? "page" : undefined}
    >
      work
    </a>
    <a
      href="/contact/"
      aria-current={
        Astro.url.pathname.startsWith("/contact") ? "page" : undefined
      }
    >
      contact
    </a>
    <a
      href="https://github.com/ghostdevhv"
      target="_blank"
      rel="noopener noreferrer"
    >
      github{" "}
      <svg
        class="ui-arrow"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 18 18 6M6 6h12v12" />
      </svg>
    </a>
  </nav>
  <ThemeControl />
</header>
