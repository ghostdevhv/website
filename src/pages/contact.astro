---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Get in touch · Himanshu Verma"
  bodyClass="inner-page sky-page contact-page"
>
  <main id="main">
    <section
      class="contact-layout"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="contact-intro">
        <p class="eyebrow">KEEP IN TOUCH</p>
        <h1 id="contact-title">Let’s talk.</h1>
        <p class="contact-lede">
          Building something interesting? I’d love to hear about it.
        </p>
        <p class="contact-note">
          A new idea, a question, a track I should hear, or a place I should
          try. Always happy to chat.
        </p>
      </div>
      <div class="contact-links" aria-label="Ways to get in touch">
        <a
          class="contact-link"
          href="https://www.linkedin.com/in/himanshu-verma-1b930990/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-link-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M5.4 3.5a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8ZM3.8 9h3.3v11H3.8Zm5.7 0h3.2v1.5c.8-1.2 1.9-1.8 3.5-1.8 3 0 4 1.8 4 5V20h-3.3v-5.6c0-1.5-.3-2.7-1.9-2.7-1.7 0-2.2 1.1-2.2 2.8V20H9.5Z" />
            </svg>
          </span>
          <span class="contact-link-text">
            <strong>LinkedIn</strong>
            <span>himanshu-verma</span>
          </span>
          <span class="contact-link-arrow" aria-hidden="true">
            <svg
              class="ui-arrow"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M6 18 18 6M6 6h12v12" />
            </svg>
          </span>
        </a>
        <a
          class="contact-link"
          href="https://www.instagram.com/thenormieman/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-link-icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle
                cx="17.5"
                cy="6.5"
                r=".9"
                fill="currentColor"
                stroke="none"
              />
            </svg>
          </span>
          <span class="contact-link-text">
            <strong>Instagram</strong>
            <span>@thenormieman</span>
          </span>
          <span class="contact-link-arrow" aria-hidden="true">
            <svg
              class="ui-arrow"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M6 18 18 6M6 6h12v12" />
            </svg>
          </span>
        </a>
        <a class="contact-link" href="mailto:contact@ghostdevhv.me">
          <span class="contact-link-icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
              <path d="m3.5 6 8.5 7L20.5 6" />
            </svg>
          </span>
          <span class="contact-link-text">
            <strong>Email</strong>
            <span>contact@ghostdevhv.me</span>
          </span>
          <span class="contact-link-arrow" aria-hidden="true">
            <svg
              class="ui-arrow"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M6 18 18 6M6 6h12v12" />
            </svg>
          </span>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
